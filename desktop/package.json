{
  "name": "room-designer-desktop",
  "productName": "Room Designer",
  "version": "0.2.0",
  "description": "Design your room in 3D.",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/mrmajko123/room-designer",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrmajko123/room-designer.git"
  },
  "author": {
    "name": "Room Designer contributors",
    "email": "room-designer@users.noreply.github.com"
  },
  "scripts": {
    "prepare-web": "node ../scripts/prepare-web.js www",
    "start": "npm run prepare-web && electron .",
    "dist": "npm run prepare-web && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "io.github.mrmajko123.roomdesigner",
    "productName": "Room Designer",
    "copyright": "Room Designer contributors, MIT license",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "phone-link.js",
      "www/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Room-Designer-Setup-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Room Designer"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.lifestyle",
      "identity": null,
      "artifactName": "Room-Designer-${version}-macOS-${arch}.${ext}",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Room Designer talks to your phone over Wi-Fi when you scan your things with it."
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "synopsis": "Design your room in 3D",
      "maintainer": "Room Designer contributors <room-designer@users.noreply.github.com>",
      "artifactName": "Room-Designer-${version}-Linux-${arch}.${ext}",
      "executableName": "room-designer"
    },
    "publish": null
  }
}
